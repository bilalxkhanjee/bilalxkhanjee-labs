{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/kairova-agency/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|jpg|svg|mp4|webm)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    }
  ]
}
